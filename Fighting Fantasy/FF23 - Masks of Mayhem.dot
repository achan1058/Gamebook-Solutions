digraph {
	// graph defaults
	rankdir=LR
	mclimit=50
	nodesep=.3 // changes horizontal separation of nodes
	ranksep=.4 // changes vertical separation of nodes
	node [height=.7
		width=.7
		shape=ellipse
		margin=0]
	edge[weight=5]
	stylesheet="../style.css"
	
	subgraph ShopMenu {
		node [fontcolor = "purple" shape = "rect" margin = 0.1]
//		menu
	}

	// a box for a graph label
	// note that you can override the defaults set above
	title [label = "Fighting Fantasy #23: Masks of Mayhem\n\n \
		Light Green Fill: Benefits\l \
		Pink Fill: Penalties\l \
		Red Fill: Death\l \
		Blue Text: Key Items/Events\l \
		Red Text: Lost Items/Negative Events\l \
		Purple Text: Shops\l \
		Blue Line: Forced Items/Events\l \
		Light Blue Text/Line: Optional Items/Events\l \
		Purple Line: Dice Events\l \
		Green Line: Stat Test Passed\l \
		Brown Line: Stat Test Failed\l \
		Magenta Line: Combat Related Events\l \
		Grey Text: Riddle/Numeric Code\l \
		Grey Line: Hidden Option\l \
		Red Line: Possible Error\l \
		Gold Fill: Required Nodes\l \
		Light Blue Fill: Recommended Nodes\l \
		Gold Outline: Recommended Path\l \
		Green Box: Combat\l \
		SK/ST/LK/AT/AR: Skill/Stamina/Luck/Attack Strength/Attack Round\l \
		?: Chance of this happening, depending on instructions in text\l \
		*: Special Combat Rules\l \
		+: Positive Status\l \
		^: Damage can be reduced by items\l \
		@: Take 2 items\l\l \
		Starting Stats:\l \
		Initial Skill: 1d+6\l \
		Initial Stamina: 2d+12\l \
		Initial Luck: 1d+6\l\l \
		Starting Gear:\l \
		skill/stamina/luck potion: +all SK / +all ST/ +all LK & +1ILK\l \
		10 meal: +4ST\l \
		sword\l \
		leather armor\l \
		backpack\l\l \
		Key Items:\l \
		magic bow/Wight sword: Can go above ISK.\l \
		Hever horn: -1ESK unless instructed otherwise.\l \
		-water flaak: Meal restore +3ST instead of +4ST\l \
		227-: Meals restore 3ST at mountain\l \
		cmtt\l\l \
		Special Combat Rules:\l \
		-: Immune to horn of Hever\l \
		Mordida: Enemy alternately attacks. If lose AR vs first, lose additional -2ST.\l \
		Tentacle (207*): Roll d6 before each tentacle 1-2: -1ST, 5-6: +1DG\l \
		rules\l\l \
		Notes:\l \
		Order: meal/gold/item/AT/SK/ST/LK\l \
		"
		shape = "box"
		margin = 0.1]
		
